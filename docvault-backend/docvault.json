{
  "title": "DocVault Overview",
  "uid": "docvault-main",
  "timezone": "browser",
  "refresh": "30s",
  "schemaVersion": 38,
  "panels": [
    {
      "id": 1,
      "title": "HTTP Request Rate (req/s) — All Services",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "color": { "mode": "palette-classic" }, "unit": "reqps" },
        "overrides": []
      },
      "options": { "tooltip": { "mode": "multi" }, "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [
        {
          "expr": "sum(rate(http_server_requests_seconds_count{job=~\"gateway|documents|comments|esb\"}[1m])) by (job)",
          "legendFormat": "{{job}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "HTTP p95 Latency (ms) — All Services",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "color": { "mode": "palette-classic" }, "unit": "ms" },
        "overrides": []
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(http_server_requests_seconds_bucket{job=~\"gateway|documents|comments|esb\"}[1m])) by (le, job)) * 1000",
          "legendFormat": "p95 {{job}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "title": "JVM Heap Memory Used (MB) — All Services",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "color": { "mode": "palette-classic" }, "unit": "decmbytes" },
        "overrides": []
      },
      "targets": [
        {
          "expr": "jvm_memory_used_bytes{area=\"heap\",job=~\"gateway|documents|comments|esb\"} / 1024 / 1024",
          "legendFormat": "heap {{job}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "title": "Kafka Consumer Lag — document-events",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 100 },
              { "color": "red", "value": 1000 }
            ]
          },
          "mappings": []
        },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "orientation": "auto", "textMode": "auto", "colorMode": "background" },
      "targets": [
        {
          "expr": "sum(kafka_consumer_fetch_manager_records_lag{topic=\"document-events\"}) or vector(0)",
          "legendFormat": "Lag",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "title": "Documents Uploaded (total)",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "color": "blue", "value": null }]
          }
        },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background" },
      "targets": [
        {
          "expr": "sum(increase(http_server_requests_seconds_count{job=\"documents\",uri=\"/api/documents\",method=\"POST\",status=\"201\"}[24h])) or vector(0)",
          "legendFormat": "Uploads today",
          "refId": "A"
        }
      ]
    },
    {
      "id": 6,
      "title": "HTTP 4xx/5xx Error Rate — All Services",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "color": { "mode": "palette-classic" }, "unit": "reqps" },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum(rate(http_server_requests_seconds_count{job=~\"gateway|documents|comments|esb\",status=~\"4..|5..\"}[1m])) by (job, status)",
          "legendFormat": "{{job}} {{status}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 7,
      "title": "Active JWT Sessions (Redis keys)",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 12 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "redis_db_keys{db=\"db0\"} or vector(0)",
          "legendFormat": "Redis keys",
          "refId": "A"
        }
      ]
    },
    {
      "id": 8,
      "title": "Service Health — Up/Down",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 12 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red",   "value": 0 },
              { "color": "green", "value": 1 }
            ]
          },
          "mappings": [
            { "options": { "0": { "text": "DOWN" }, "1": { "text": "UP" } }, "type": "value" }
          ]
        },
        "overrides": []
      },
      "targets": [
        { "expr": "up{job=\"gateway\"}",   "legendFormat": "gateway",   "refId": "A" },
        { "expr": "up{job=\"documents\"}", "legendFormat": "documents", "refId": "B" },
        { "expr": "up{job=\"comments\"}",  "legendFormat": "comments",  "refId": "C" },
        { "expr": "up{job=\"esb\"}",       "legendFormat": "esb",       "refId": "D" }
      ]
    }
  ]
}